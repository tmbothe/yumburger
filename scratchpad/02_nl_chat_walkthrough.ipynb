  {
   "cell_type": "markdown",
   "id": "e2e-function-header",
   "metadata": {},
   "source": [
    "---\n",
    "## Bonus — Single-Function End-to-End\n",
    "\n",
    "Now that we understand every step, here is the entire pipeline collapsed into\n",
    "one function — this is essentially what the `/ask` FastAPI endpoint does.\n",
    "Use this to quickly test different questions."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e2e-function",
   "metadata": {},
   "outputs": [],
   "source": [
    "def ask(question: str, persona: str = 'analyst', max_rows: int = 20) -> dict:\n",
    "    \"\"\"\n",
    "    Full NL→SQL→Athena→Answer pipeline in one call.\n",
    "    Returns a dict with answer, sql, row_count, and duration_ms.\n",
    "    \"\"\"\n",
    "    t_start = time.time()\n",
    "\n",
    "    # 1. Load schema (would be cached in production)\n",
    "    schema = {}\n",
    "    for table in ALLOWED_TABLES:\n",
    "        rows = run_athena(f'DESCRIBE {SILVER_DB}.{table}', database=SILVER_DB)\n",
    "        schema[table] = [\n",
    "            {'col_name': r['col_name'], 'data_type': r['data_type']}\n",
    "            for r in rows if r.get('col_name') and not r['col_name'].startswith('#')\n",
    "        ]\n",
    "\n",
    "    # 2. Load ontology\n",
    "    mappings = run_athena('SELECT * FROM ontology_mapping', database=SEMANTIC_DB)\n",
    "    hints    = resolve_ontology_hints(question, mappings)\n",
    "\n",
    "    # 3. Build prompt and call Bedrock\n",
    "    user_prompt = f\"\"\"Schema context (table -> columns):\n",
    "{json.dumps(schema, indent=2)}\n",
    "\n",
    "Ontology hints:\n",
    "{json.dumps(hints[:20], indent=2)}\n",
    "\n",
    "Question: {question}\n",
    "Return ONLY the SQL query.\"\"\"\n",
    "\n",
    "    body = {\n",
    "        'anthropic_version': 'bedrock-2023-05-31',\n",
    "        'max_tokens': 1024,\n",
    "        'system': SYSTEM_PROMPT,\n",
    "        'messages': [{'role': 'user', 'content': user_prompt}]\n",
    "    }\n",
    "    raw = json.loads(\n",
    "        bedrock_client.invoke_model(\n",
    "            modelId=BEDROCK_MODEL_ID, body=json.dumps(body),\n",
    "            contentType='application/json', accept='application/json'\n",
    "        )['body'].read()\n",
    "    )['content'][0]['text']\n",
    "\n",
    "    # 4. Clean and verify SQL\n",
    "    cleaned = re.sub(r'```sql\\s*', '', raw, flags=re.IGNORECASE)\n",
    "    cleaned = re.sub(r'```\\s*', '', cleaned).strip()\n",
    "    sql     = verify_sql(cleaned, ALLOWED_TABLES, SILVER_DB)\n",
    "\n",
    "    # 5. Assume persona role and execute\n",
    "    sts_r  = sts_client.assume_role(\n",
    "        RoleArn=ROLE_MAP[persona],\n",
    "        RoleSessionName=f'yumBurger-ask-{persona}',\n",
    "        DurationSeconds=900\n",
    "    )\n",
    "    p_creds = sts_r['Credentials']\n",
    "    p_sess  = boto3.Session(\n",
    "        aws_access_key_id=p_creds['AccessKeyId'],\n",
    "        aws_secret_access_key=p_creds['SecretAccessKey'],\n",
    "        aws_session_token=p_creds['SessionToken'],\n",
    "        region_name=AWS_REGION\n",
    "    )\n",
    "    result_rows = run_athena(sql, database=SILVER_DB, client=p_sess.client('athena'))\n",
    "\n",
    "    # 6. Summarize\n",
    "    sum_body = {\n",
    "        'anthropic_version': 'bedrock-2023-05-31',\n",
    "        'max_tokens': 512,\n",
    "        'system': BODHI_SYSTEM,\n",
    "        'messages': [{\n",
    "            'role': 'user',\n",
    "            'content': f'Question: {question}\\n\\nResults:\\n{json.dumps(result_rows[:max_rows], default=str)}'\n",
    "        }]\n",
    "    }\n",
    "    answer = json.loads(\n",
    "        bedrock_client.invoke_model(\n",
    "            modelId=BEDROCK_MODEL_ID, body=json.dumps(sum_body),\n",
    "            contentType='application/json', accept='application/json'\n",
    "        )['body'].read()\n",
    "    )['content'][0]['text']\n",
    "\n",
    "    return {\n",
    "        'question'   : question,\n",
    "        'answer'     : answer,\n",
    "        'compiled_sql': sql,\n",
    "        'row_count'  : len(result_rows),\n",
    "        'duration_ms': int((time.time() - t_start) * 1000)\n",
    "    }\n",
    "\n",
    "\n",
    "print('✓ ask() function defined — ready to run')"
   ]
  },
